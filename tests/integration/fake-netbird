#!/usr/bin/env python3
"""Stand-in for the netbird CLI: forwards its command to fake-netbirdd over a
unix socket and prints the answer, so it works as any user, like the real CLI."""

import json
import os
import socket
import sys

SOCK = os.environ.get("FAKE_NETBIRD_SOCK", "/run/fake-netbird.sock")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "version":
        print("0.0.0-fake")
        return 0
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
    except OSError as e:
        print(f"failed to connect to daemon error: {e}", file=sys.stderr)
        return 1
    with s:
        s.sendall(cmd.encode())
        s.shutdown(socket.SHUT_WR)
        data = b""
        while chunk := s.recv(65536):
            data += chunk
    reply = json.loads(data)
    sys.stdout.write(reply["out"])
    sys.stderr.write(reply["err"])
    return reply["rc"]


if __name__ == "__main__":
    sys.exit(main())
